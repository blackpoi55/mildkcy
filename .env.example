# ---- Google Sheets (ถ้าไม่ใส่ ระบบจะทำงานใน "โหมดทดลอง" เก็บข้อมูลในไฟล์ .data/db.json) ----
# ID ของชีต: ส่วนที่อยู่ระหว่าง /d/ และ /edit ใน URL
GOOGLE_SHEET_ID=
# อีเมลของ Service Account (client_email ในไฟล์ JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# private_key ในไฟล์ JSON (ใส่ในเครื่องหมายคำพูด คงค่า \n ไว้ตามเดิม)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- รหัสผ่านเข้าใช้งาน (ไม่บังคับ แต่ควรตั้งเมื่อเอาขึ้นออนไลน์) ----
APP_PASSWORD=
